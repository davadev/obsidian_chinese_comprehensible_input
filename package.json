{
	"name": "chinese-comprehensible-input",
	"version": "0.7.1",
	"description": "Obsidian plugin: Chinese comprehensible input reading view with dictionary tokenization, SRS, and AI story generation.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"build:hsk": "node scripts/build-hsk-map.mjs",
		"build:topics": "node scripts/build-topic-map.mjs",
		"build:fixture": "node scripts/build-cedict-fixture.mjs",
		"check-release": "node scripts/check-release.mjs",
		"lint": "eslint 'src/**/*.ts'",
		"lint:fix": "eslint 'src/**/*.ts' --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:cov": "vitest run --coverage",
		"test:cov:open": "vitest run --coverage && open coverage/index.html"
	},
	"keywords": [
		"obsidian",
		"chinese",
		"language-learning",
		"srs",
		"comprehensible-input"
	],
	"author": "Daniel Vavrik",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/lang-markdown": "^6.2.5",
		"@codemirror/language": "^6.10.2",
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@lezer/highlight": "^1.2.0",
		"@types/node": "^20.11.30",
		"@vitest/coverage-v8": "4.1.11",
		"esbuild": "^0.21.4",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"obsidian": "^1.5.7",
		"tslib": "^2.6.2",
		"typescript": "^5.4.5",
		"typescript-eslint": "^8.70.0",
		"vitest": "5.0.0"
	},
	"allowScripts": {
		"esbuild": false,
		"fsevents": false
	}
}
