{
	"name": "chinese-comprehensible-input",
	"version": "0.9.2",
	"description": "Obsidian plugin: Chinese comprehensible input reading view with dictionary tokenization, SRS, and AI story generation.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"build:hsk": "node scripts/build-hsk-map.mjs",
		"build:topics": "node scripts/build-topic-map.mjs",
		"build:radicals": "node scripts/build-radicals.mjs",
		"build:fixture": "node scripts/build-cedict-fixture.mjs",
		"check-release": "node scripts/check-release.mjs",
		"lint": "eslint 'src/**/*.ts' --max-warnings=0",
		"lint:fix": "eslint 'src/**/*.ts' --fix",
		"lint:css": "stylelint styles.css",
		"lint:cloud-parity": "node scripts/lint-cloud-parity.mjs",
		"check:dead-code": "knip --production && knip --no-config-hints --include dependencies,unlisted,binaries,unresolved",
		"check:layout": "node scripts/check-eink-layout.mjs",
		"check:screenshots": "node scripts/render-screenshots.mjs --check",
		"check:webkit": "node scripts/check-webkit-layout.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:cov": "vitest run --coverage",
		"test:cov:open": "vitest run --coverage && open coverage/index.html"
	},
	"keywords": [
		"obsidian",
		"chinese",
		"language-learning",
		"srs",
		"comprehensible-input"
	],
	"author": "Daniel Vavrik",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/lang-markdown": "6.5.2",
		"@codemirror/language": "^6.13.1",
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@lezer/highlight": "^1.2.0",
		"@types/node": "^24",
		"@vitest/coverage-v8": "5.0.2",
		"esbuild": "0.28.2",
		"eslint": "^10.12.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"happy-dom": "20.14.6",
		"knip": "^6.41.0",
		"obsidian": "^1.14.4",
		"playwright": "1.64.0",
		"stylelint": "17.16.0",
		"stylelint-no-unsupported-browser-features": "8.1.2",
		"tslib": "^2.6.2",
		"typescript": "^5.4.5",
		"typescript-eslint": "^8.71.1",
		"vitest": "5.0.2"
	},
	"allowScripts": {
		"esbuild": false,
		"fsevents": false
	},
	"overrides": {
		"@codemirror/lang-html": "6.4.11",
		"@codemirror/lang-css": "6.3.1",
		"@codemirror/lang-javascript": "6.2.5",
		"@lezer/markdown": "1.6.4",
		"@lezer/html": "1.3.13",
		"@lezer/css": "1.3.3",
		"@lezer/javascript": "1.5.4"
	}
}
