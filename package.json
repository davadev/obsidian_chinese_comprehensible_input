{
  "name": "chinese-comprehensible-input",
  "version": "0.1.36",
  "description": "Obsidian plugin: Chinese comprehensible input reading view with dictionary tokenization, SRS, and AI story generation.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "build:hsk": "node scripts/build-hsk-map.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": ["obsidian", "chinese", "language-learning", "srs", "comprehensible-input"],
  "author": "Daniel Vavrik",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.2.5",
    "@codemirror/language": "^6.10.2",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "^6.28.0",
    "@lezer/highlight": "^1.2.0",
    "@types/node": "^20.11.30",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.21.4",
    "obsidian": "^1.5.7",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
